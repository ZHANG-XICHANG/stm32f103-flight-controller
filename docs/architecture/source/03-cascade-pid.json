  "cards": [
    { "dot": "emerald", "title": "PID_calc（每 6 ms，dt = 0.006 s）", "items": [
      "e = desire − measure；I += e·dt；u = Kp·e + Ki·I + Kd·D（com_pid.c:9-47）",
      "外環 D = de/dt；內環 D = −d(measure)/dt，再經 10 Hz 一階低通（α ≈ 0.726）",
      "串級：外環輸出直接成為內環 desire（com_pid.c:58-64）",
      "PID_calc 內沒有輸出限幅或積分抗飽和；目前 Ki = 0，實際為 PD 控制"
    ] },
    { "dot": "cyan", "title": "混控（flight.c:383-405）", "items": [
      "M1 = base − pitch − roll + yaw",
      "M2 = base − pitch + roll − yaw",
      "M3 = base + pitch + roll + yaw",
      "M4 = base + pitch − roll − yaw；每路限幅 1100–1940 µs"
    ] },
    { "dot": "amber", "title": "同一迴圈的其他軸與調參", "items": [
      "Yaw 只有角速度環：gyro_z_pid（Kp 2、Ki 0.1），搖桿對應 ±90°/s（flight.c:292-297）",
      "增益可由 24 B PID 指令於執行時改寫，Ki 改變時清除積分（pid_command.c:33-41）",
      "圖中增益為原始碼初值，不代表實機調參後的數值"
    ] }
