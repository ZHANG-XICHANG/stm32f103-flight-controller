  "cards": [
    {
      "dot": "emerald",
      "title": "三個任務（freertos.c:64-131）",
      "items": [
        "myTask（High，6 ms）：FlightState_Process → Calculate_EulerAngle → Calculate_PIDOutput → Flight_control_motor",
        "myTask02（Normal，6 ms）：無線未就緒時每 100 ms 重試 Receive_Init；每輪最多讀 3 包，最後呼叫 FlightState_Update",
        "myTask03（Low，20 ms）：LED2 在 IDLE 長亮；LED1 連線 500 ms、失聯 100 ms 切換"
      ]
    },
    {
      "dot": "cyan",
      "title": "任務間共享方式",
      "items": [
        "程式未建立 Queue / Semaphore / Mutex（freertos.c:107-121 皆為空），任務以全域變數交換資料",
        "Telemetry、PidCommand 與 remoteData.power 讀取時使用 taskENTER_CRITICAL 保護；remoteData 其他欄位直接讀寫"
      ]
    },
    {
      "dot": "rose",
      "title": "連線新鮮度",
      "items": [
        "只有通過幀頭與校驗的 17 B 控制封包會呼叫 FlightState_RemoteReceived（freertos.c:224-228）",
        "24 B PID 指令回傳 RECEIVE_INVALID，不會刷新連線時間（receive.c:93-97）"
      ]
    }
  ]
